# ---- MLflow on DagsHub (Task 3) ----
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub_username>
MLFLOW_TRACKING_PASSWORD=<dagshub_token>

# ---- Flask app (Task 4) ----
MODEL_DIR=models/champion
THRESHOLD=0.74
DATABASE_URL=sqlite:///visionguard.db
MAX_UPLOAD_MB=4
SECRET_KEY=<random-hex>
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# ---- PostgreSQL for Docker Compose (Task 6) ----
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<strong password>

# ---- Remote model API on Vercel (Task 7 / Task 8) ----
# local  = load the Keras model inside Flask
# remote = send every upload to the Vercel model API (uploads capped at 4 MB)
INFERENCE_MODE=remote
API_URL=https://<project>.vercel.app
# Must be exactly the API_KEY set in Vercel -> Project -> Settings -> Environment Variables
API_KEY=<same secret as on Vercel>
API_TIMEOUT=30
